@model WebApplication2.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
    var approvedUsersCount = Model.AllUsers.Count(u => u.IsApproved && u.ApprovalStatusId == 2);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h2 class="mb-0">Admin Dashboard</h2>
        <p class="text-muted mb-0 small">Review user registrations, approve detail submissions, manage accounts, and control the Product Table.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Products" asp-action="Create" class="btn btn-primary">+ Add Product</a>
        <a asp-controller="Products" asp-action="Index" class="btn btn-outline-dark">Manage Product Table</a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card shadow-sm border-warning h-100">
            <div class="card-body">
                <div class="text-muted small">Pending Requests</div>
                <div class="fs-3 fw-bold text-warning">@Model.PendingRequests.Count</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card shadow-sm border-primary h-100">
            <div class="card-body">
                <div class="text-muted small">Total Accounts</div>
                <div class="fs-3 fw-bold text-primary">@Model.AllUsers.Count</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card shadow-sm border-success h-100">
            <div class="card-body">
                <div class="text-muted small">Approved Accounts</div>
                <div class="fs-3 fw-bold text-success">@approvedUsersCount</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card shadow-sm border-dark h-100">
            <div class="card-body">
                <div class="text-muted small">Products</div>
                <div class="fs-3 fw-bold">@Model.Products.Count</div>
            </div>
        </div>
    </div>
</div>

<!-- Pending Registration & Detail Update Requests -->
<div class="card shadow-sm mb-4 border-warning">
    <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Pending Approval Requests</h5>
        <span class="badge bg-dark">@Model.PendingRequests.Count Pending</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Type</th>
                        <th>User</th>
                        <th>Submitted Personal Details</th>
                        <th>Submitted At (UTC)</th>
                        <th style="min-width: 280px;">Decision &amp; Remarks</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.PendingRequests.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">No pending registration or detail update requests.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var req in Model.PendingRequests)
                        {
                            <tr>
                                <td>#@req.RequestId</td>
                                <td>
                                    <span class="badge @(req.RequestType == "Registration" ? "bg-primary" : "bg-info text-dark")">
                                        @req.RequestType
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-semibold">@(req.SubmittedName ?? req.User?.Name)</div>
                                    <div class="small text-muted">@(req.SubmittedEmail ?? req.User?.Email)</div>
                                    <a asp-controller="Admin" asp-action="UserDetails" asp-route-id="@req.UserId" class="small">View User Profile</a>
                                </td>
                                <td class="small">
                                    <div><strong>Phone:</strong> @(req.PhoneNumber ?? "-")</div>
                                    <div><strong>Dept:</strong> @(req.Department ?? "-")</div>
                                    <div><strong>Address:</strong> @(req.Address ?? "-")</div>
                                    <div><strong>Details:</strong> @(req.PersonalDetails ?? "-")</div>
                                </td>
                                <td class="small text-nowrap">@req.SubmittedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    <form method="post" asp-controller="Admin">
                                        @Html.AntiForgeryToken()
                                        <div class="input-group input-group-sm mb-2">
                                            <input type="text" name="remarks" class="form-control" maxlength="250" placeholder="Optional admin remarks..." />
                                        </div>
                                        <div class="d-flex gap-2">
                                            <button type="submit"
                                                    formaction="@Url.Action("ApproveRequest", "Admin", new { id = req.RequestId })"
                                                    class="btn btn-sm btn-success">
                                                Approve
                                            </button>
                                            <button type="submit"
                                                    formaction="@Url.Action("RejectRequest", "Admin", new { id = req.RequestId })"
                                                    class="btn btn-sm btn-danger">
                                                Reject
                                            </button>
                                        </div>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- All Registered Users -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">All Registered Users</h5>
        <span class="badge bg-secondary">@Model.AllUsers.Count Total</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Phone / Dept</th>
                        <th>Created (UTC)</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.AllUsers)
                    {
                        var roleName = user.UserRole?.RoleName ?? user.Role ?? "User";
                        var statusName = user.ApprovalStatus?.StatusName ?? (user.IsApproved ? "Approved" : "Pending");
                        var statusBadge = statusName switch
                        {
                            "Approved" => "bg-success",
                            "Rejected" => "bg-danger",
                            _ => "bg-warning text-dark"
                        };
                        var isCurrentUser = string.Equals(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, user.ID.ToString(), StringComparison.Ordinal);

                        <tr>
                            <td>@user.ID</td>
                            <td class="fw-semibold">@user.Name</td>
                            <td>@user.Email</td>
                            <td>
                                <span class="badge @(roleName == "Admin" ? "bg-warning text-dark" : "bg-info text-dark")">
                                    @roleName
                                </span>
                            </td>
                            <td>
                                <span class="badge @statusBadge">@statusName</span>
                            </td>
                            <td class="small">
                                <div>@(user.PhoneNumber ?? "-")</div>
                                <div class="text-muted">@(user.Department ?? "-")</div>
                            </td>
                            <td class="small text-nowrap">@user.CreatedAt.ToString("yyyy-MM-dd")</td>
                            <td class="text-end text-nowrap">
                                <a asp-controller="Admin" asp-action="UserDetails" asp-route-id="@user.ID" class="btn btn-sm btn-outline-primary me-1">
                                    Details
                                </a>
                                @if (!user.IsApproved || user.ApprovalStatusId != 2)
                                {
                                    <form asp-controller="Admin" asp-action="ApproveUser" asp-route-id="@user.ID" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-success me-1">Approve</button>
                                    </form>
                                }
                                @if (!isCurrentUser && user.ApprovalStatusId != 3)
                                {
                                    <form asp-controller="Admin" asp-action="RejectUser" asp-route-id="@user.ID" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger me-1">Reject</button>
                                    </form>
                                }
                                @if (!isCurrentUser)
                                {
                                    <form asp-controller="Admin" asp-action="DeleteUser" asp-route-id="@user.ID" method="post" class="d-inline"
                                          data-name="@user.Name"
                                          onsubmit="return confirm('Delete user account ' + this.getAttribute('data-name') + '?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Product Management Section -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h5 class="mb-0">Product Management</h5>
        <div class="d-flex gap-2">
            <a asp-controller="Products" asp-action="Create" class="btn btn-sm btn-light">+ Add Product</a>
            <a asp-controller="Products" asp-action="Index" class="btn btn-sm btn-outline-light">Full Product Table</a>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Product Name</th>
                        <th>Description</th>
                        <th class="text-end">Price</th>
                        <th class="text-end">Admin Options</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Products.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-3">
                                No products found. <a asp-controller="Products" asp-action="Create">Add your first product</a>.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Products)
                        {
                            <tr>
                                <td>@item.prdid</td>
                                <td class="fw-semibold">@item.prdname</td>
                                <td>@item.prddescription</td>
                                <td class="text-end">@item.price.ToString("N2")</td>
                                <td class="text-end text-nowrap">
                                    <a asp-controller="Products" asp-action="Edit" asp-route-id="@item.prdid" class="btn btn-sm btn-warning me-1">Edit</a>
                                    <a asp-controller="Products" asp-action="Delete" asp-route-id="@item.prdid" class="btn btn-sm btn-danger">Delete</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Reviewed History & Create Admin -->
<div class="row g-4">
    <div class="col-lg-7">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-secondary text-white">
                <h5 class="mb-0">Recent Reviewed Requests</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Type</th>
                                <th>User</th>
                                <th>Status</th>
                                <th>Remarks</th>
                                <th>Reviewed (UTC)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.ReviewedRequests.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-3">No reviewed requests yet.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var req in Model.ReviewedRequests)
                                {
                                    var statusName = req.ApprovalStatus?.StatusName ?? "Reviewed";
                                    <tr>
                                        <td>#@req.RequestId</td>
                                        <td>@req.RequestType</td>
                                        <td>@(req.User?.Name ?? req.SubmittedName)</td>
                                        <td>
                                            <span class="badge @(statusName == "Approved" ? "bg-success" : "bg-danger")">
                                                @statusName
                                            </span>
                                        </td>
                                        <td class="small">@(req.AdminRemarks ?? "-")</td>
                                        <td class="small text-nowrap">@(req.ReviewedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0">Create Additional Admin</h5>
            </div>
            <div class="card-body">
                <form asp-controller="Admin" asp-action="CreateAdmin" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label asp-for="CreateAdminForm.Name" class="form-label"></label>
                        <input asp-for="CreateAdminForm.Name" class="form-control" placeholder="Admin username" />
                        <span asp-validation-for="CreateAdminForm.Name" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="CreateAdminForm.Email" class="form-label"></label>
                        <input asp-for="CreateAdminForm.Email" class="form-control" placeholder="admin@example.com" />
                        <span asp-validation-for="CreateAdminForm.Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="CreateAdminForm.Password" class="form-label"></label>
                        <input asp-for="CreateAdminForm.Password" class="form-control" placeholder="At least 6 characters" />
                        <span asp-validation-for="CreateAdminForm.Password" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-warning text-dark fw-semibold w-100">Create Admin Account</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
