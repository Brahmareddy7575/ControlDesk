@model WebApplication2.Models.UserDashboardViewModel
@{
    ViewData["Title"] = "User Dashboard";
    var profile = Model.Profile;
    var hasPendingChange = Model.MyRequests.Any(r => r.ApprovalStatusId == 1 && r.RequestType == "DetailUpdate");
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h2 class="mb-0">User Dashboard</h2>
        <p class="text-muted mb-0 small">View your approved profile, submit new or updated details for Admin approval, and browse products.</p>
    </div>
    <a asp-controller="Products" asp-action="Index" class="btn btn-outline-dark">
        Browse Product Table (@Model.ProductCount)
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4 mb-4">
    <!-- Approved Profile -->
    <div class="col-lg-5">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">My Approved Profile</h5>
                <span class="badge bg-light text-success">@(profile.ApprovalStatus?.StatusName ?? "Approved")</span>
            </div>
            <div class="card-body">
                @if (hasPendingChange)
                {
                    <div class="alert alert-warning small" role="alert">
                        You have a detail update currently <strong>Pending</strong> Admin approval. Approved values remain active until reviewed.
                    </div>
                }

                <dl class="row mb-0">
                    <dt class="col-sm-4">Name</dt>
                    <dd class="col-sm-8">@profile.Name</dd>

                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@profile.Email</dd>

                    <dt class="col-sm-4">Role</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-info text-dark">@(profile.UserRole?.RoleName ?? profile.Role ?? "User")</span>
                    </dd>

                    <dt class="col-sm-4">Phone</dt>
                    <dd class="col-sm-8">@(profile.PhoneNumber ?? "-")</dd>

                    <dt class="col-sm-4">Department</dt>
                    <dd class="col-sm-8">@(profile.Department ?? "-")</dd>

                    <dt class="col-sm-4">Address</dt>
                    <dd class="col-sm-8">@(profile.Address ?? "-")</dd>

                    <dt class="col-sm-4">Personal Details</dt>
                    <dd class="col-sm-8">@(profile.PersonalDetails ?? "-")</dd>

                    <dt class="col-sm-4">Joined (UTC)</dt>
                    <dd class="col-sm-8">@profile.CreatedAt.ToString("yyyy-MM-dd")</dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Submit New / Updated Details -->
    <div class="col-lg-7">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">Submit New / Update Details</h5>
                <small class="text-light opacity-75">Changes are sent to the Admin for approval before updating your profile.</small>
            </div>
            <div class="card-body">
                <form asp-controller="User" asp-action="SubmitDetails" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="UpdateForm.Name" class="form-label"></label>
                            <input asp-for="UpdateForm.Name" class="form-control" />
                            <span asp-validation-for="UpdateForm.Name" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="UpdateForm.Email" class="form-label"></label>
                            <input asp-for="UpdateForm.Email" class="form-control" />
                            <span asp-validation-for="UpdateForm.Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="UpdateForm.PhoneNumber" class="form-label"></label>
                            <input asp-for="UpdateForm.PhoneNumber" class="form-control" />
                            <span asp-validation-for="UpdateForm.PhoneNumber" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="UpdateForm.Department" class="form-label"></label>
                            <input asp-for="UpdateForm.Department" class="form-control" />
                            <span asp-validation-for="UpdateForm.Department" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="UpdateForm.Address" class="form-label"></label>
                            <input asp-for="UpdateForm.Address" class="form-control" />
                            <span asp-validation-for="UpdateForm.Address" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="UpdateForm.PersonalDetails" class="form-label"></label>
                            <textarea asp-for="UpdateForm.PersonalDetails" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="UpdateForm.PersonalDetails" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">Send Details for Admin Approval</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Request Status History -->
<div class="card shadow-sm">
    <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">My Submitted Requests &amp; Approval History</h5>
        <span class="badge bg-dark">@Model.MyRequests.Count Total</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Type</th>
                        <th>Submitted Data</th>
                        <th>Status</th>
                        <th>Admin Remarks</th>
                        <th>Submitted (UTC)</th>
                        <th>Reviewed (UTC)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.MyRequests.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">No requests submitted yet.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var req in Model.MyRequests)
                        {
                            var statusName = req.ApprovalStatus?.StatusName ?? "Pending";
                            var statusBadge = statusName switch
                            {
                                "Approved" => "bg-success",
                                "Rejected" => "bg-danger",
                                _ => "bg-warning text-dark"
                            };
                            <tr>
                                <td>#@req.RequestId</td>
                                <td>@req.RequestType</td>
                                <td class="small">
                                    <div><strong>Name:</strong> @(req.SubmittedName ?? "-") (@(req.SubmittedEmail ?? "-"))</div>
                                    <div><strong>Phone:</strong> @(req.PhoneNumber ?? "-") | <strong>Dept:</strong> @(req.Department ?? "-")</div>
                                    <div><strong>Address:</strong> @(req.Address ?? "-")</div>
                                    <div><strong>Details:</strong> @(req.PersonalDetails ?? "-")</div>
                                </td>
                                <td><span class="badge @statusBadge">@statusName</span></td>
                                <td class="small">@(req.AdminRemarks ?? "-")</td>
                                <td class="small text-nowrap">@req.SubmittedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="small text-nowrap">@(req.ReviewedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

