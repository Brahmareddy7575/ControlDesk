@model WebApplication2.Models.product
@{
    ViewData["Title"] = "Delete Product";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-danger">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0">Delete Product</h4>
            </div>
            <div class="card-body">
                <p>Are you sure you want to delete this product?</p>
                <dl class="row">
                    <dt class="col-sm-4">ID</dt>
                    <dd class="col-sm-8">@Model.prdid</dd>
                    <dt class="col-sm-4">Name</dt>
                    <dd class="col-sm-8">@Model.prdname</dd>
                    <dt class="col-sm-4">Description</dt>
                    <dd class="col-sm-8">@Model.prddescription</dd>
                    <dt class="col-sm-4">Price</dt>
                    <dd class="col-sm-8">@Model.price.ToString("N2")</dd>
                </dl>
                <form asp-controller="Products" asp-action="Delete" asp-route-id="@Model.prdid" method="post">
                    @Html.AntiForgeryToken()
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger">Confirm Delete</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

