@model IEnumerable<WebApplication2.Models.product>
@{
    ViewData["Title"] = "Product Table";
    var search = ViewBag.Search as string;
    var isAdmin = User.IsInRole("Admin");
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h2 class="mb-0">Product Table</h2>
        <p class="text-muted mb-0 small">
            @(isAdmin ? "Add, modify, and delete products" : "View and search products (read-only User role)")
        </p>
    </div>
    <div class="d-flex gap-2">
        @if (isAdmin)
        {
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addProductModal">
                + Add Product
            </button>
            <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-outline-secondary">Admin Dashboard</a>
        }
        else
        {
            <a asp-controller="User" asp-action="Dashboard" class="btn btn-outline-secondary">User Dashboard</a>
        }
    </div>
</div>

@if (!isAdmin)
{
    <div class="alert alert-info" role="alert">
        Signed in with the <strong>User</strong> role (read-only). Sign in with an <strong>Admin</strong> account to add, modify, or delete products.
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm mb-3">
    <div class="card-body py-2">
        <form asp-controller="Products" asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-sm-8 col-md-5">
                <input type="text" name="search" value="@search" class="form-control form-control-sm" placeholder="Search by product name or description..." />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-outline-primary">Search</button>
                @if (!string.IsNullOrWhiteSpace(search))
                {
                    <a asp-controller="Products" asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear</a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Product Name</th>
                        <th>Description</th>
                        <th class="text-end">Price</th>
                        @if (isAdmin)
                        {
                            <th class="text-end" style="width: 210px;">Options</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="@(isAdmin ? 5 : 4)" class="text-center text-muted py-4">
                                @if (isAdmin)
                                {
                                    <span>No products found. Click <strong>+ Add Product</strong> to add an item.</span>
                                }
                                else
                                {
                                    <span>No products found.</span>
                                }
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.prdid</td>
                                <td class="fw-semibold">@item.prdname</td>
                                <td>@item.prddescription</td>
                                <td class="text-end">@item.price.ToString("N2")</td>
                                @if (isAdmin)
                                {
                                    <td class="text-end">
                                        <button type="button"
                                                class="btn btn-sm btn-warning me-1"
                                                data-bs-toggle="modal"
                                                data-bs-target="#editProductModal"
                                                data-id="@item.prdid"
                                                data-name="@item.prdname"
                                                data-description="@item.prddescription"
                                                data-price="@item.price.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                            Modify
                                        </button>
                                        <button type="button"
                                                class="btn btn-sm btn-danger"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteProductModal"
                                                data-id="@item.prdid"
                                                data-name="@item.prdname">
                                            Delete
                                        </button>
                                    </td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (isAdmin)
{
    <!-- Add Product Modal -->
    <div class="modal fade" id="addProductModal" tabindex="-1" aria-labelledby="addProductModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-controller="Products" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title" id="addProductModalLabel">Add Product</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="add-prdname" class="form-label">Product Name</label>
                            <input id="add-prdname" name="prdname" class="form-control" maxlength="20" required placeholder="Enter product name" />
                        </div>
                        <div class="mb-3">
                            <label for="add-prddescription" class="form-label">Description</label>
                            <input id="add-prddescription" name="prddescription" class="form-control" maxlength="40" placeholder="Enter description" />
                        </div>
                        <div class="mb-3">
                            <label for="add-price" class="form-label">Price</label>
                            <input id="add-price" name="price" type="number" step="0.01" min="0" value="0.00" class="form-control" required />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Add Product</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modify Product Modal -->
    <div class="modal fade" id="editProductModal" tabindex="-1" aria-labelledby="editProductModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="editProductForm" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="edit-prdid" name="prdid" />
                    <div class="modal-header">
                        <h5 class="modal-title" id="editProductModalLabel">Modify Product</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="edit-prdname" class="form-label">Product Name</label>
                            <input id="edit-prdname" name="prdname" class="form-control" maxlength="20" required />
                        </div>
                        <div class="mb-3">
                            <label for="edit-prddescription" class="form-label">Description</label>
                            <input id="edit-prddescription" name="prddescription" class="form-control" maxlength="40" />
                        </div>
                        <div class="mb-3">
                            <label for="edit-price" class="form-label">Price</label>
                            <input id="edit-price" name="price" type="number" step="0.01" min="0" class="form-control" required />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-warning">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Delete Product Modal -->
    <div class="modal fade" id="deleteProductModal" tabindex="-1" aria-labelledby="deleteProductModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="deleteProductForm" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title" id="deleteProductModalLabel">Delete Product</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        Are you sure you want to delete <strong id="delete-prdname"></strong>?
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            const editModal = document.getElementById('editProductModal');
            if (editModal) {
                editModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    const id = button.getAttribute('data-id');
                    document.getElementById('editProductForm').action = '/Products/Edit/' + id;
                    document.getElementById('edit-prdid').value = id;
                    document.getElementById('edit-prdname').value = button.getAttribute('data-name') || '';
                    document.getElementById('edit-prddescription').value = button.getAttribute('data-description') || '';
                    document.getElementById('edit-price').value = button.getAttribute('data-price') || '0';
                });
            }

            const deleteModal = document.getElementById('deleteProductModal');
            if (deleteModal) {
                deleteModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    const id = button.getAttribute('data-id');
                    document.getElementById('deleteProductForm').action = '/Products/Delete/' + id;
                    document.getElementById('delete-prdname').textContent = button.getAttribute('data-name') || '';
                });
            }
        </script>
    }
}
