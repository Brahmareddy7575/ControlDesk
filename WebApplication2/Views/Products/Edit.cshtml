@model WebApplication2.Models.product
@{
    ViewData["Title"] = "Modify Product";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-warning text-dark">
                <h4 class="mb-0">Modify Product</h4>
            </div>
            <div class="card-body">
                <form asp-controller="Products" asp-action="Edit" asp-route-id="@Model.prdid" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="prdid" />
                    <div class="mb-3">
                        <label asp-for="prdname" class="form-label"></label>
                        <input asp-for="prdname" class="form-control" />
                        <span asp-validation-for="prdname" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="prddescription" class="form-label"></label>
                        <input asp-for="prddescription" class="form-control" />
                        <span asp-validation-for="prddescription" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="price" class="form-label"></label>
                        <input asp-for="price" class="form-control" type="number" step="0.01" min="0" />
                        <span asp-validation-for="price" class="text-danger small"></span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning">Save Changes</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Back to Table</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

