@{
    ViewData["Title"] = "Home";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole("Admin");
}

<div class="py-3">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="p-4 p-md-5 mb-4 bg-white border rounded-3 shadow-sm">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <h1 class="display-6 fw-bold mb-2">Admin &amp; User Portal</h1>
                <p class="text-muted mb-0">
                    Role-based authentication, registration approval workflow, user detail submissions, and PostgreSQL product management.
                </p>
            </div>
            <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                @if (!isAuthenticated)
                {
                    <div class="d-flex flex-wrap gap-2 justify-content-lg-end">
                        <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Login</a>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-success">Register</a>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-wrap gap-2 justify-content-lg-end">
                        @if (isAdmin)
                        {
                            <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-warning">Go to Admin Dashboard</a>
                        }
                        else
                        {
                            <a asp-controller="User" asp-action="Dashboard" class="btn btn-primary">Go to User Dashboard</a>
                        }
                        <a asp-controller="Products" asp-action="Index" class="btn btn-outline-dark">Product Table</a>
                    </div>
                }
            </div>
        </div>
    </div>

    @if (!isAuthenticated)
    {
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card shadow-sm h-100 border-warning">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0">Admin Login</h5>
                    </div>
                    <div class="card-body d-flex flex-column">
                        <p class="text-muted flex-grow-1">
                            Sign in as an Administrator to review pending user registrations, approve or reject detail changes, and add, modify, or delete products.
                        </p>
                        <a asp-controller="Account" asp-action="AdminLogin" class="btn btn-warning w-100">Admin Login</a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm h-100 border-primary">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">User Login</h5>
                    </div>
                    <div class="card-body d-flex flex-column">
                        <p class="text-muted flex-grow-1">
                            Approved users can sign in with their username or email to view their dashboard, submit detail updates for Admin approval, and view products.
                        </p>
                        <a asp-controller="Account" asp-action="UserLogin" class="btn btn-primary w-100">User Login</a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm h-100 border-success">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">User Registration</h5>
                    </div>
                    <div class="card-body d-flex flex-column">
                        <p class="text-muted flex-grow-1">
                            New users can register with their personal details. Accounts start with <strong>Pending</strong> status until approved by an Admin.
                        </p>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-success w-100">Register New User</a>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <h5 class="mb-1">
                        Signed in as <strong>@User.Identity?.Name</strong>
                        <span class="badge @(isAdmin ? "bg-warning text-dark" : "bg-info text-dark") ms-1">
                            @(isAdmin ? "Admin" : "User")
                        </span>
                    </h5>
                    <p class="text-muted mb-0">
                        @(isAdmin
                            ? "You have full Administrator access to user approvals and the Product Table."
                            : "You can view your User Dashboard, submit details for Admin approval, and browse the Product Table.")
                    </p>
                </div>
                <div class="d-flex gap-2">
                    @if (isAdmin)
                    {
                        <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-warning">Admin Dashboard</a>
                    }
                    else
                    {
                        <a asp-controller="User" asp-action="Dashboard" class="btn btn-primary">User Dashboard</a>
                    }
                    <a asp-controller="Products" asp-action="Index" class="btn btn-outline-dark">Product Table</a>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger">Logout</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
